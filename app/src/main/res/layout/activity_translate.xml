<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gray_light">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarTranslate"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary_dark"
        app:title="@string/translate"
        app:titleTextColor="#FFFFFF"
        app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        android:background="@drawable/bg_rounded_white">

        <LinearLayout
            android:id="@+id/btnLangEn"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="English"
                android:textSize="16sp"
                android:textColor="@color/black" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/arrow_down_float"
                android:rotation="-90"
                android:contentDescription="Arrow" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gray_border" android:layout_marginStart="20dp" />

        <LinearLayout
            android:id="@+id/btnLangAr"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="العربية"
                android:textSize="16sp"
                android:textColor="@color/black" />

            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/arrow_down_float" android:rotation="-90" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gray_border" android:layout_marginStart="20dp" />

        <LinearLayout
            android:id="@+id/btnLangFr"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Français" android:textSize="16sp" android:textColor="@color/black" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/arrow_down_float" android:rotation="-90" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gray_border" android:layout_marginStart="20dp" />

        <LinearLayout
            android:id="@+id/btnLangZh"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="中文" android:textSize="16sp" android:textColor="@color/black" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/arrow_down_float" android:rotation="-90" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gray_border" android:layout_marginStart="20dp" />

        <LinearLayout
            android:id="@+id/btnLangJa"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="日本語" android:textSize="16sp" android:textColor="@color/black" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/arrow_down_float" android:rotation="-90" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gray_border" android:layout_marginStart="20dp" />

        <LinearLayout
            android:id="@+id/btnLangEs"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Español" android:textSize="16sp" android:textColor="@color/black" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/arrow_down_float" android:rotation="-90" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/gray_border" android:layout_marginStart="20dp" />

        <LinearLayout
            android:id="@+id/btnLangDe"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Deutsch" android:textSize="16sp" android:textColor="@color/black" />
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/arrow_down_float" android:rotation="-90" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
